---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      * {
        box-sizing: border-box;
      }

      html {
        background: #f2efe8;
        color: #292722;
        font-family: Helvetica, Arial, sans-serif;
        font-size: 18px;
        line-height: 1.45;
      }

      body {
        margin: 0;
      }

      a {
        color: #164f78;
      }

      .page {
        margin: 0 auto;
        max-width: 980px;
        padding: 24px 18px 50px;
      }

      .site-title {
        color: #292722;
        display: inline-block;
        font-size: 28px;
        font-weight: bold;
        margin: 0 0 28px;
        text-decoration: none;
      }

      h1 {
        font-size: 32px;
        line-height: 1.15;
        margin: 0 0 24px;
      }

      h2 {
        font-size: 24px;
        margin: 30px 0 12px;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 18px;
        padding: 8px 0;
      }

      .empty {
        color: #69655d;
      }

      .post-list {
        border-top: 1px solid #ccc6ba;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .post-list li {
        border-bottom: 1px solid #ccc6ba;
        margin: 0;
        padding: 0;
      }

      .post-list a {
        display: block;
        font-size: 21px;
        padding: 17px 4px;
        text-decoration: none;
      }

      .post-list .count {
        color: #69655d;
        font-size: 16px;
        margin-left: 8px;
      }

      .category-link {
        background: #fff;
        border: 1px solid #d4cec2;
        border-radius: 5px;
        display: block;
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 16px;
        padding: 24px;
        text-decoration: none;
      }

      .category-link small {
        color: #69655d;
        display: block;
        font-size: 16px;
        font-weight: normal;
        margin-top: 5px;
      }

      .gallery {
        font-size: 0;
        margin: -5px;
      }

      .thumbnail {
        background: #ddd8cf;
        border: 5px solid #f2efe8;
        display: inline-block;
        vertical-align: top;
        width: 25%;
      }

      .thumbnail img {
        border: 0;
        display: block;
        height: auto;
        width: 100%;
      }

      @media screen and (max-width: 760px) {
        .thumbnail {
          width: 33.333%;
        }
      }

      @media screen and (max-width: 520px) {
        html {
          font-size: 17px;
        }

        .page {
          padding-left: 12px;
          padding-right: 12px;
        }

        .thumbnail {
          width: 50%;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <a class="site-title" href="/">Luka &amp; Vanja</a>
      <slot />
    </div>
  </body>
</html>
